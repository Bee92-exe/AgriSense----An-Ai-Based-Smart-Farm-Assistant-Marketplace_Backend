// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------
// Enums
// ------------------------------------------

enum Role {
  FARMER
  VENDOR
  EXPERT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Exactly the four categories the app already renders (`NewsCategory` in
/// enums.dart). A fifth value here would not fail loudly — the client falls back
/// to "disease" — so the wire contract deliberately stays at four.
enum NewsCategory {
  DISEASE
  PEST
  VIRUS
  NUTRIENT_DEFICIENCY
  WEATHER
  MARKET
  ADVISORY
}

/// Mirrors the app's `Severity` (low/medium/high/urgent).
enum NewsSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// A Krishi Barta item. Only `PUBLISHED` rows ever reach a farmer; anything the
/// RSS ingest pulls in lands as `DRAFT` so a human approves it first.
enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ------------------------------------------
// Core User Management
// ------------------------------------------

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(120)
  mobileNumber        String     @unique @db.VarChar(16)
  passwordHash        String     @db.VarChar(255)
  role                Role       @default(FARMER)
  status              UserStatus @default(ACTIVE)
  location            String?    @db.VarChar(120)
  avatarUrl           String?    @db.Text
  tokenVersion        Int        @default(0)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  farmerProfile       Farmer?
  vendorProfile       Vendor?
  expertProfile       Expert?
  diagnoses           Diagnosis[]
  orders              Order[]
  feedbacks           Feedback[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  adminAuditLogs      AdminAuditLog[]      @relation("AdminAuditActor")
  newsAuthored        NewsItem[]           @relation("NewsAuthor")
  newsReads           NewsRead[]           @relation("NewsReader")

  // Community surfaces (expert articles, questions, consultations)
  articleLikes        ArticleLike[]        @relation("ArticleLikes")
  articleSaves        ArticleSave[]        @relation("ArticleSaves")
  articleRatings      ArticleRating[]      @relation("ArticleRatings")
  articleComments     ArticleComment[]     @relation("ArticleComments")
  askedQuestions      ExpertQuestion[]     @relation("FarmerQuestions")
  consultations       ConsultationBooking[] @relation("FarmerBookings")
  vendorNotes         VendorCustomerNote[] @relation("VendorCustomerNotes")

  @@index([role])
  @@index([status])
}

model Farmer {
  id              String  @id @default(uuid()) @db.Uuid
  farmLocation    String? @db.VarChar(160)
  cropPreferences String? @db.Text
  landSize        Float?

  userId          String  @unique @db.Uuid
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id                 String    @id @default(uuid()) @db.Uuid
  shopName           String    @db.VarChar(160)
  verificationStatus String    @default("PENDING") @db.VarChar(20)
  businessLicense    String?   @db.VarChar(160)

  userId             String    @unique @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  orders             Order[]

  /// Aggregate of `VendorRating`, recomputed on every new rating.
  rating             Float     @default(0)
  ratingCount        Int       @default(0)
  ratings            VendorRating[]

  /// The shop's own bookkeeping: notes about buyers, the payout ledger and the
  /// storefront visit counter the business screen reports.
  customerNotes      VendorCustomerNote[]
  payouts            VendorPayout[]
  visits             VendorVisit[]
}

model Expert {
  id             String  @id @default(uuid()) @db.Uuid
  specialization String  @db.VarChar(120)
  certification  String? @db.VarChar(160)
  verified       Boolean @default(false)

  userId         String  @unique @db.Uuid
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewedDiagnoses Diagnosis[]     @relation("ExpertReviews")
  knowledgeBase     KnowledgeBase[]

  /// The expert's public writing, their queue of farmer questions, the
  /// consultations they sell and the colleagues they have connected with.
  articles          ExpertArticle[]
  questions         ExpertQuestion[]     @relation("ExpertAnswers")
  plans             ConsultationPlan[]
  peers             ExpertPeer[]         @relation("ExpertPeerOwner")
  peerOf            ExpertPeer[]         @relation("ExpertPeerTarget")
  sourceSuggestions NewsSourceSuggestion[]
}

// ------------------------------------------
// Authentication & Sessions
// ------------------------------------------

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  tokenHash           String    @unique @db.VarChar(64)
  userId              String    @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?   @db.VarChar(64)
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Every administrative approval or status change. Kept separate from the
/// operational logs so an approval can always be traced to the person who made
/// it, even after the target account is removed.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  actor      User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String   @db.VarChar(40)
  targetType String   @db.VarChar(20)
  targetId   String   @db.Uuid
  reason     String?  @db.Text
  message    String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ------------------------------------------
// AI Diagnosis Module
// ------------------------------------------

model Diagnosis {
  id                String   @id @default(uuid()) @db.Uuid
  imageUrl          String   @db.Text
  aiDetectedDisease String   @db.VarChar(160)
  confidenceScore   Float
  treatmentSteps    String   @db.Text
  status            String   @default("COMPLETED") @db.VarChar(30) // PENDING_REVIEW, COMPLETED
  timestamp         DateTime @default(now())
  clientUuid        String?  @unique @db.Uuid

  expertReview      String?  @db.Text
  expertId          String?  @db.Uuid
  expert            Expert?  @relation("ExpertReviews", fields: [expertId], references: [id])

  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expertId])
  @@index([status])
}

// ------------------------------------------
// Marketplace Module (Haat_Bazar)
// ------------------------------------------

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(160)
  category    String   @db.VarChar(60)
  description String?  @db.Text
  price       Float
  stockLevel  Int
  rating      Float    @default(0.0)
  imageUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendorId    String   @db.Uuid
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  orderDetails OrderDetail[]

  @@index([vendorId])
  @@index([category])
}

model Order {
  id              String   @id @default(uuid()) @db.Uuid

  /// Nullable so the column can be added to an existing table; the API always
  /// writes one and falls back to a derived number for older rows.
  orderNo         String?  @unique @db.VarChar(24)
  orderDate       DateTime @default(now())
  status          String   @default("PENDING") @db.VarChar(30)
  totalAmount     Float
  paymentMethod   String   @db.VarChar(40)
  deliveryAddress String   @db.Text

  /// touch | voice (FR-19 `placed_via`).
  placedVia       String   @default("touch") @db.VarChar(10)
  note            String?  @db.Text

  /// Idempotency key from the app; a retry returns the original order.
  clientUuid      String?  @unique @db.Uuid

  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A basket is single-vendor, so the order itself belongs to one vendor.
  vendorId        String?  @db.Uuid
  vendor          Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  details         OrderDetail[]
  events          OrderEvent[]

  @@index([userId])
  @@index([vendorId])
}

/// Append-only status history, because the farmer-facing timeline must show
/// when each transition actually happened rather than only the current state.
model OrderEvent {
  id      String   @id @default(uuid()) @db.Uuid
  orderId String   @db.Uuid
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  String   @db.VarChar(30)
  at      DateTime @default(now())

  @@index([orderId])
}

/// FR-26. One rating per farmer per vendor; `userId` is taken from the token.
model VendorRating {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @db.Uuid
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@index([vendorId])
}

model OrderDetail {
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int
  subtotal  Float

  @@id([orderId, productId])
  @@index([productId])
}

// ------------------------------------------
// Advisory & System Data
// ------------------------------------------

model WeatherSoilData {
  id            String   @id @default(uuid()) @db.Uuid
  district      String   @unique @db.VarChar(80)
  soilType      String   @db.VarChar(60)
  temperature   Float
  humidity      Float
  rainfall      Float
  weatherAlerts String?  @db.Text
  updatedAt     DateTime @updatedAt
}

model KnowledgeBase {
  id                String   @id @default(uuid()) @db.Uuid
  diseaseName       String   @unique @db.VarChar(160)
  diseaseData       String   @db.Text
  treatmentProtocol String   @db.Text
  cropType          String   @db.VarChar(80)
  updatedAt         DateTime @updatedAt

  expertId          String   @db.Uuid
  expert            Expert   @relation(fields: [expertId], references: [id])

  @@index([expertId])
}

model Feedback {
  id         String   @id @default(uuid()) @db.Uuid
  rating     Float
  comments   String?  @db.Text
  targetType String   @db.VarChar(30) // PRODUCT, DIAGNOSIS, APP
  targetId   String?  @db.Uuid // Reference ID if applicable
  createdAt  DateTime @default(now())

  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------
// Krishi Barta (news)
// ------------------------------------------

/// One news card. Only `PUBLISHED` rows are ever served to a farmer; RSS
/// ingest always lands as `DRAFT` so a human approves it first.
model NewsItem {
  id                String       @id @default(uuid()) @db.Uuid
  titleBn           String       @db.VarChar(200)
  titleEn           String?      @db.VarChar(200)
  summaryBn         String       @db.Text
  summaryEn         String?      @db.Text
  symptomsBn        String?      @db.Text
  advisedActionBn   String?      @db.Text
  category          NewsCategory @default(DISEASE)
  crop              String?      @db.VarChar(40)
  severity          NewsSeverity @default(LOW)
  affectedDistricts String[]     @default([])
  sourceName        String       @db.VarChar(160)
  sourceUrl         String?      @db.Text
  verifiedBy        String?      @db.VarChar(120)
  imageUrls         String[]     @default([])
  isUrgent          Boolean      @default(false)
  status            NewsStatus   @default(DRAFT)

  /// Feed GUID/link, so re-running the ingest cannot duplicate an item.
  externalId        String?      @unique @db.VarChar(300)

  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  authorId          String?      @db.Uuid
  author            User?        @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads             NewsRead[]

  @@index([status, publishedAt])
  @@index([category])
  @@index([crop])
}

/// Per-farmer read receipt (FR-46). The id pair makes it idempotent.
model NewsRead {
  newsId String   @db.Uuid
  news   NewsItem @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId String   @db.Uuid
  user   User     @relation("NewsReader", fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())

  @@id([newsId, userId])
  @@index([userId])
}

// ------------------------------------------
// RAG knowledge chunks
// ------------------------------------------

/// Source-grounded advisory chunks. The embedding is managed by raw SQL
/// because Prisma does not yet model pgvector columns as insertable fields.
model KnowledgeChunk {
  id        String                 @id @default(uuid()) @db.Uuid
  chunkId   String                 @unique @map("chunk_id") @db.VarChar(100)
  crop      String                 @db.VarChar(80)
  disease   String                 @db.VarChar(160)
  diseaseId String?                @map("disease_id") @db.VarChar(80)
  diseaseBn String                 @map("disease_bn") @db.VarChar(160)
  content   String                 @db.Text
  metadata  Json?
  embedding Unsupported("vector(768)")?
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([diseaseId])
  @@map("knowledge_chunks")
}

// ------------------------------------------
// Vendor CRM (payouts, customer book, visits)
// ------------------------------------------

/// A shop's private note about a buyer, plus the follow-up flag. One row per
/// (vendor, customer) pair, so a note can be edited but never duplicated.
model VendorCustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  vendorId   String   @db.Uuid
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  customer   User     @relation("VendorCustomerNotes", fields: [customerId], references: [id], onDelete: Cascade)
  note       String   @db.Text
  followUp   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([vendorId, customerId])
  @@index([vendorId])
}

/// Append-only payout ledger. A row is money the platform owes the shop, or has
/// already paid. The net figure is derived from real order subtotals, never
/// invented by the client.
model VendorPayout {
  id          String    @id @default(uuid()) @db.Uuid
  vendorId    String    @db.Uuid
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount      Float
  status      String    @default("PENDING") @db.VarChar(20) // PENDING | PAID
  reference   String?   @db.VarChar(120)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([vendorId, createdAt])
}

/// One farmer opening a shop's storefront. Recorded by an explicit app event so
/// "visits" and conversion are measured rather than estimated.
model VendorVisit {
  id       String   @id @default(uuid()) @db.Uuid
  vendorId String   @db.Uuid
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String?  @db.Uuid
  at       DateTime @default(now())

  @@index([vendorId, at])
}

// ------------------------------------------
// Expert community (articles, questions, consultations)
// ------------------------------------------

/// A published piece of expert writing. Farmers read it in the advisory feed;
/// the author sees their own drafts and stats.
model ExpertArticle {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  summary     String   @db.Text
  body        String   @db.Text
  crop        String   @db.VarChar(40)
  /// Index into the app's painted cover tints; no image download required.
  coverTone   Int      @default(0)
  status      String   @default("PUBLISHED") @db.VarChar(20) // DRAFT | PUBLISHED
  hidden      Boolean  @default(false)
  views       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expertId    String   @db.Uuid
  expert      Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)

  likes       ArticleLike[]
  saves       ArticleSave[]
  ratings     ArticleRating[]
  comments    ArticleComment[]

  @@index([status, publishedAt])
  @@index([crop])
  @@index([expertId])
}

/// Idempotent like: the composite id makes a second tap a no-op, not a double.
model ArticleLike {
  articleId String        @db.Uuid
  article   ExpertArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation("ArticleLikes", fields: [userId], references: [id], onDelete: Cascade)
  at        DateTime      @default(now())

  @@id([articleId, userId])
  @@index([userId])
}

model ArticleSave {
  articleId String        @db.Uuid
  article   ExpertArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation("ArticleSaves", fields: [userId], references: [id], onDelete: Cascade)
  at        DateTime      @default(now())

  @@id([articleId, userId])
  @@index([userId])
}

/// One rating per reader per article; the article's average is recomputed on
/// write so a listing never has to aggregate on read.
model ArticleRating {
  articleId String        @db.Uuid
  article   ExpertArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation("ArticleRatings", fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  at        DateTime      @default(now())

  @@id([articleId, userId])
}

model ArticleComment {
  id        String        @id @default(uuid()) @db.Uuid
  articleId String        @db.Uuid
  article   ExpertArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation("ArticleComments", fields: [userId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  likes     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([articleId, createdAt])
}

/// A farmer asking a person, not an article. `expertId` stays null until an
/// expert answers, which is also what makes the queue shared.
model ExpertQuestion {
  id          String    @id @default(uuid()) @db.Uuid
  farmerId    String    @db.Uuid
  farmer      User      @relation("FarmerQuestions", fields: [farmerId], references: [id], onDelete: Cascade)
  expertId    String?   @db.Uuid
  expert      Expert?   @relation("ExpertAnswers", fields: [expertId], references: [id], onDelete: SetNull)
  crop        String    @db.VarChar(40)
  question    String    @db.Text
  /// `message | call | video` — how the farmer wants the answer.
  mode        String    @default("message") @db.VarChar(20)
  urgent      Boolean   @default(false)
  status      String    @default("OPEN") @db.VarChar(20) // OPEN | ANSWERED
  reply       String?   @db.Text
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([expertId])
  @@index([farmerId])
}

/// A consultation subscription an expert sells.
model ConsultationPlan {
  id        String   @id @default(uuid()) @db.Uuid
  expertId  String   @db.Uuid
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(160)
  /// `monthly | quarterly | yearly`
  period    String   @db.VarChar(20)
  price     Float
  perks     String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  bookings  ConsultationBooking[]

  @@index([expertId])
}

model ConsultationBooking {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  plan      ConsultationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  farmerId  String   @db.Uuid
  farmer    User     @relation("FarmerBookings", fields: [farmerId], references: [id], onDelete: Cascade)
  topic     String   @db.VarChar(200)
  /// `call | video | visit`
  mode      String   @db.VarChar(20)
  at        DateTime
  minutes   Int      @default(30)
  status    String   @default("UPCOMING") @db.VarChar(20) // UPCOMING | DONE | CANCELLED
  createdAt DateTime @default(now())

  @@index([planId, at])
  @@index([farmerId])
}

/// A connection between two experts. Directed: the owner row records who
/// connected to whom, so unfollowing does not delete the other direction.
model ExpertPeer {
  expertId    String   @db.Uuid
  expert      Expert   @relation("ExpertPeerOwner", fields: [expertId], references: [id], onDelete: Cascade)
  peerId      String   @db.Uuid
  peer        Expert   @relation("ExpertPeerTarget", fields: [peerId], references: [id], onDelete: Cascade)
  connectedAt DateTime @default(now())

  @@id([expertId, peerId])
  @@index([peerId])
}

/// An expert proposing a news feed for the admin to add.
model NewsSourceSuggestion {
  id        String   @id @default(uuid()) @db.Uuid
  expertId  String   @db.Uuid
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(160)
  url       String   @db.Text
  note      String?  @db.Text
  status    String   @default("PENDING") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([status])
  @@index([expertId])
}
